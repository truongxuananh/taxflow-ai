MYSQL_DATABASE=taxflow
MYSQL_USER=taxflow
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_ROOT_PASSWORD=change_this_root_password

JWT_SECRET=change_this_to_a_random_secret_at_least_32_characters
JWT_ISSUER=TaxFlowAI
JWT_AUDIENCE=TaxFlowAI.Client

# AI Provider: hybrid | local | demo | paddle | tesseract | openai | gemini
# paddle: PaddleOCR (FREE, best for Vietnamese, local) ← RECOMMENDED
# tesseract: Tesseract OCR (FREE, local)
# openai: OpenAI Vision API ($$, highest quality)
# gemini: Google Gemini API ($, high quality)
# Fallback chain: paddle → openai → gemini → tesseract → demo
AI_PROVIDER=hybrid

# OpenAI Configuration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini Configuration (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

STORAGE_PATH=/app/storage
VITE_API_URL=/api
ASPNETCORE_ENVIRONMENT=Production

# Local OCR microservice
AI_SERVICE_URL=http://ai-service:8000
HYBRID_CONFIDENCE_THRESHOLD=0.82

# Completion upgrade: optional HTTPS invoice bridge. Demo remains the default.
INVOICE_PROVIDER=demo
INVOICE_GATEWAY_URL=
INVOICE_GATEWAY_KEY=
# Local laptop by default; use 0.0.0.0 deliberately for a trusted network.
BIND_ADDRESS=127.0.0.1

# natural: Gemini selects validated read-only business tools; legacy: keyword fallback
ASSISTANT_MODE=natural
